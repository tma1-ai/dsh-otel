{
  "uid": "dsh-logs",
  "title": "DSH \u00b7 Log explorer",
  "description": "Every session event as a log record. Four attributes are real columns, so filtering by session, event type, turn, and step is a plain WHERE rather than JSON extraction.",
  "tags": [
    "dsh",
    "greptimedb",
    "genai",
    "logs"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "greptimedb"
        },
        "query": "SELECT DISTINCT session_id FROM dsh_logs WHERE session_id IS NOT NULL ORDER BY 1 DESC LIMIT 200",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": "%",
        "current": {
          "text": "All",
          "value": "%"
        }
      },
      {
        "name": "event_type",
        "label": "Event type",
        "type": "query",
        "datasource": {
          "type": "mysql",
          "uid": "greptimedb"
        },
        "query": "SELECT DISTINCT event_type FROM dsh_logs WHERE event_type IS NOT NULL ORDER BY 1",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": "%",
        "current": {
          "text": "All",
          "value": "%"
        }
      },
      {
        "name": "search",
        "label": "Body search",
        "type": "textbox",
        "query": "",
        "description": "Full-text term match over the record body; empty matches everything.",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Overview",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "title": "Events",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT COUNT(*) AS events FROM dsh_logs WHERE $__timeFilter(timestamp) AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search'))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Sessions",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT COUNT(DISTINCT session_id) AS sessions FROM dsh_logs WHERE $__timeFilter(timestamp) AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search'))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT COUNT(*) AS errors FROM dsh_logs WHERE $__timeFilter(timestamp) AND severity_text = 'ERROR' AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search'))"
        }
      ],
      "description": "Tool results whose own block reports isError, and turns that ended with the error reason."
    },
    {
      "type": "stat",
      "title": "Event types seen",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT COUNT(DISTINCT event_type) AS kinds FROM dsh_logs WHERE $__timeFilter(timestamp) AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search'))"
        }
      ]
    },
    {
      "type": "row",
      "title": "Event stream",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "logs",
      "title": "Events",
      "description": "One record per session event. Expand a line to see the structured body.",
      "datasource": {
        "type": "info8fcc-greptimedb-datasource",
        "uid": "greptimedb-traces"
      },
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "info8fcc-greptimedb-datasource",
            "uid": "greptimedb-traces"
          },
          "editorType": "builder",
          "format": 2,
          "queryType": "logs",
          "builderOptions": {
            "database": "public",
            "table": "dsh_logs",
            "queryType": "logs",
            "mode": "list",
            "columns": [
              {
                "name": "timestamp",
                "hint": "time"
              },
              {
                "name": "severity_text",
                "hint": "log_level"
              },
              {
                "name": "body",
                "hint": "log_message"
              },
              {
                "name": "session_id"
              },
              {
                "name": "event_type"
              },
              {
                "name": "turn"
              },
              {
                "name": "step"
              }
            ],
            "filters": [
              {
                "filterType": "custom",
                "key": "",
                "hint": "time",
                "operator": "WITH IN DASHBOARD TIME RANGE",
                "type": "datetime",
                "condition": "AND"
              }
            ],
            "orderBy": [
              {
                "name": "timestamp",
                "hint": "time",
                "dir": "desc"
              }
            ],
            "limit": 500,
            "meta": {
              "otelEnabled": true,
              "otelVersion": "latest"
            }
          },
          "rawSql": "SELECT \"timestamp\" AS timestamp, body AS body, severity_text AS level, session_id, event_type, \"turn\", \"step\" FROM dsh_logs WHERE $__timeFilter(\"timestamp\") AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search')) ORDER BY \"timestamp\" DESC LIMIT 500"
        }
      ]
    },
    {
      "type": "row",
      "title": "Shape of the stream",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Events over time by type",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT date_bin('5 minutes'::INTERVAL, timestamp) AS time, event_type, COUNT(*) AS events FROM dsh_logs WHERE $__timeFilter(timestamp) AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search')) GROUP BY time, event_type ORDER BY time"
        }
      ]
    },
    {
      "type": "barchart",
      "title": "Event types",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 21
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "event_type",
        "orientation": "horizontal",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT event_type, COUNT(*) AS events FROM dsh_logs WHERE $__timeFilter(timestamp) AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search')) GROUP BY event_type ORDER BY events DESC"
        }
      ]
    },
    {
      "type": "row",
      "title": "Errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "table",
      "title": "Error events",
      "description": "Severity is pre-mapped at capture, so this needs no query-side interpretation.",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "trace_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open this turn in the trace explorer",
                    "url": "/d/dsh-traces/a?var-trace_id=${__value.raw}&var-session=%25&var-outcome=all&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "See this session in the trace explorer",
                    "url": "/d/dsh-traces/a?var-session=${__value.raw}&var-trace_id=&var-outcome=all&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT timestamp, session_id, event_type, \"turn\", \"step\", body, trace_id FROM dsh_logs WHERE $__timeFilter(timestamp) AND severity_text = 'ERROR' AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search')) ORDER BY timestamp DESC LIMIT 100"
        }
      ]
    },
    {
      "type": "table",
      "title": "Busiest sessions",
      "datasource": {
        "type": "mysql",
        "uid": "greptimedb"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "session_id"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "See this session in the trace explorer",
                    "url": "/d/dsh-traces/a?var-session=${__value.raw}&var-trace_id=&var-outcome=all&${__url_time_range}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawQuery": true,
          "datasource": {
            "type": "mysql",
            "uid": "greptimedb"
          },
          "rawSql": "SELECT session_id, COUNT(*) AS events, MAX(\"turn\") AS turns, SUM(CASE WHEN severity_text = 'ERROR' THEN 1 ELSE 0 END) AS errors, MIN(timestamp) AS first_seen, MAX(timestamp) AS last_seen FROM dsh_logs WHERE $__timeFilter(timestamp) AND session_id LIKE '$session' AND event_type LIKE '$event_type' AND ('$search' = '' OR matches_term(body, '$search')) GROUP BY session_id ORDER BY events DESC LIMIT 50"
        }
      ]
    }
  ]
}
